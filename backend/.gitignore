# Laravel - Git Ignore

# Arquivos de ambiente
.env
.env.backup
.env.production
.env.local
.env.*.local

# Logs
*.log
storage/logs/*.log

# Arquivos do sistema operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
ehthumbs.db

# IDEs e editores
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
.phpactor.json
.phpunit.result.cache

# Dependências
/vendor
/node_modules

# Build e assets
/public/build
/public/hot
/public/storage
/public/mix-manifest.json

# Storage
/storage/*.key
/storage/pail
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore

# Cache
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# Arquivos de configuração
/auth.json
Homestead.json
Homestead.yaml
.phpstorm.meta.php
_ide_helper.php
_ide_helper_models.php

# Arquivos de teste
/.phpunit.cache
/coverage
.phpunit.result.cache

# Arquivos temporários
*.tmp
*.temp
*.bak
*.backup
*.old
*.swp
*.swo
*~

# Arquivos de backup do banco
*.sql
*.dump

# Docker
docker-compose.override.yml
.dockerignore

# Arquivos de CI/CD
.github/workflows/*.local.yml
